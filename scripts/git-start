#!/usr/bin/env bash

set -euo pipefail

BASE=origin/staging

if [ $# -ne 1 ] || [ -z "$1" ]; then
  echo "Usage: git start <branch-name>" >&2
  exit 1
fi

echo "Fetching $BASE..."
git fetch origin

echo "Creating $1 from $BASE..."
# --no-track, or a later bare `git push` would aim at the protected origin/staging.
git switch --no-track -c "$1" "$BASE"

echo
echo "When you are ready:  git push -u origin HEAD"
