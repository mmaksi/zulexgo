#!/usr/bin/env bash
# VERCEL_ENV is production on each stage's own deploy; previews carry no database credentials.
set -euo pipefail

if [ "${VERCEL_ENV:-}" = "production" ] && [ "${REPOSITORY_DRIVER:-}" = "postgres" ]; then
  npm run db:migrate
  if [ "${APP_ENV:-}" = "staging" ]; then
    npm run db:seed
  fi
fi

npm run build
