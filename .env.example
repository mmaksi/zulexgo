# ZulexGO environment template. Copy to .env.local for dev; set staging and
# production values in the deployment platform, never here.
#
# A variable is required only when the thing that needs it is switched on, so
# dev boots on fakes with no secrets at all. src/config/env.ts is the contract:
# it fails at startup naming the variable rather than halfway through checkout.

# ── Stage ────────────────────────────────────────────────────────────────────
# dev | staging | production. The only stage switch; never branch on NODE_ENV.
APP_ENV=dev

# Public origin of this deployment. Defaults to http://localhost:3000 in dev;
# required and must be https everywhere else — status links travel over it.
APP_BASE_URL=

# Bearer token the Vercel Cron heartbeat presents to /api/internal/poll.
# Required outside dev. Generate with: openssl rand -base64 32
CRON_SECRET=

# ── Adapter selection ────────────────────────────────────────────────────────
# Which implementation of each port to wire. Production rejects every fake.
PAYMENT_DRIVER=fake         # fake | stripe
REGISTRATION_DRIVER=fake    # fake | zulex
MAIL_DRIVER=console         # console | resend (resend is refused in dev)
REPOSITORY_DRIVER=fake      # fake | postgres
STORAGE_DRIVER=fake         # fake | supabase

# ── Stripe (required when PAYMENT_DRIVER=stripe) ─────────────────────────────
# Live keys are rejected outside production; test keys are rejected in it.
# Secret API key (sk_test_… / sk_live_…). Server-side only.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (whsec_…), to verify Stripe events.
STRIPE_WEBHOOK_SECRET=
# The only Stripe value that may reach the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Zulex API (required when REGISTRATION_DRIVER=zulex) ──────────────────────
# dev, staging: https://integration-zulex.de/zulex-api/v1
# production:   https://app.zulex.de/zulex-api/v1
# Any other host for the stage is rejected at boot.
ZULEX_BASE_URL=
# Merchant credential sent as X-Api-Key. Server-side only — never NEXT_PUBLIC_.
ZULEX_API_KEY=

# ── Mail (required when MAIL_DRIVER=resend) ──────────────────────────────────
# Resend API key (re_…). Server-side only.
RESEND_API_KEY=
# Comma-separated addresses staging is allowed to mail. Required on staging so
# seeded data cannot reach a real person; must be empty in production.
MAIL_ALLOWLIST=

# ── Database (required when REPOSITORY_DRIVER=postgres) ──────────────────────
# Supavisor transaction-mode pooler (port 6543); used by the app at request time.
DATABASE_URL=
# Session connection, used by migrations only (npm run db:migrate). On Vercel
# and GitHub Actions, both IPv4-only, this is the Supavisor session pooler
# (port 5432): the direct db.<ref>.supabase.co host is IPv6-only.
DIRECT_DATABASE_URL=
# AES-256-GCM key for security codes and status tokens at rest, 32 base64
# bytes, one per stage. Losing it makes every stored code unreadable: keep a
# copy outside the deployment platform. Generate with: openssl rand -base64 32
CODES_ENCRYPTION_KEY=
# Tests only: a Postgres server where the Postgres suites create and drop their
# own databases. Unset locally, they skip; CI always sets it (CONTRIBUTING.md).
TEST_DATABASE_URL=

# ── Document storage (required when STORAGE_DRIVER=supabase) ─────────────────
# Project URL of the Supabase project that holds the documents.
SUPABASE_STORAGE_URL=
# Name of the private bucket for KBA confirmations.
SUPABASE_STORAGE_BUCKET=
# Service-role key. Server-side only; the bucket is private and never exposed.
SUPABASE_STORAGE_SERVICE_KEY=
